{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/use-brian/agent-docs/blob/main/showcases/schema.json",
  "title": "Use Brian showcase catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "evidence_notice", "showcases"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "evidence_notice": {
      "type": "string",
      "minLength": 1
    },
    "showcases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/showcase" }
    }
  },
  "$defs": {
    "showcase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "category",
        "status",
        "evidence_level",
        "data_kind",
        "expected_result",
        "capabilities",
        "tags",
        "record_path",
        "public_approval",
        "media"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["prepared", "needs-rework", "candidate", "released"]
        },
        "evidence_level": {
          "type": "string",
          "enum": ["specification", "verified-demonstration", "customer-evidence"]
        },
        "data_kind": {
          "type": "string",
          "enum": ["synthetic", "internal-approved", "customer-approved"]
        },
        "expected_result": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "record_path": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.md$"
        },
        "last_verified": {
          "type": ["string", "null"],
          "format": "date"
        },
        "public_approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved", "approved_at", "scope"],
          "properties": {
            "approved": { "type": "boolean", "const": true },
            "approved_at": { "type": "string", "format": "date" },
            "scope": {
              "type": "string",
              "const": "scenario-discovery-only"
            }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["video_url", "poster_url"],
          "properties": {
            "video_url": { "type": ["string", "null"], "format": "uri" },
            "poster_url": { "type": ["string", "null"], "format": "uri" }
          }
        }
      }
    }
  }
}
